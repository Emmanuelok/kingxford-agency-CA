  "scripts": {
    "dev": "npm run build:print && next dev",
    "build": "npm run build:print && next build && node scripts/verify-built-styles.mjs",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "build:print": "tsc --project apps/print/tsconfig.json && vite build --config apps/print/vite.config.ts",
    "test:print": "cd apps/print && node --experimental-strip-types tests/quote-engine.test.mjs && node --experimental-strip-types tests/cloud-security.test.mjs && node --experimental-strip-types --test tests/api-handlers.test.mjs && node --experimental-strip-types --test tests/artwork-v2.test.mjs tests/workspace-v2.test.mjs tests/templates-v2.test.mjs tests/production-package.test.mjs tests/pdf-artwork.test.mjs tests/image-crop.test.mjs tests/photo-scenes.test.mjs"
  },
