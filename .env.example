# Copy to .env.local. Never commit real credentials.
# Production must use the exact live origin; configure preview deployments separately.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Use a publishable key, or a legacy anon key. Secret/service-role keys are rejected.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Use a project-scoped key with an explicit provider budget cap.
AI_GATEWAY_API_KEY=
# Select and verify a supported text model from GET /v1/models.
AVALON_AI_MODEL=
# Enable only after database quota + cross-account RLS tests pass.
AVALON_AI_ENABLED=false
# Existing KINGXFORD_AI_MODEL and KINGXFORD_AI_ENABLED remain supported when
# their Avalon counterparts are absent. Explicit Avalon values take precedence.
# Hero assets are hosted with the site by default.
NEXT_PUBLIC_AVALON_MEDIA_ROOT=/video
# Legacy media setting is supported for existing deployments.
NEXT_PUBLIC_KINGXFORD_MEDIA_ROOT=/video
